# Local deploy config — used by deploy/remote.sh (pack + upload). Not committed.
# Copy once: cp .env.pack.example .env.pack
# Then fill SSH_* below; afterwards: bash deploy/remote.sh

POSTGRES_USER=timia
POSTGRES_PASSWORD=pack-only-not-used
POSTGRES_DB=timia
NEXT_PUBLIC_API_BASE_URL=https://timia.online/core-service

# Remote upload (persist here so you don't export every time)
SSH_HOST=your.server.ip
SSH_USER=root
# SSH_IDENTITY_FILE=~/.ssh/your.pem
# DEPLOY_PATH=/opt/timia
