// Local Docker stack (`make docker-up`): nginx on :8080.
// Simulator: 127.0.0.1 is fine. Physical device / same LAN: replace with `ipconfig getifaddr en0`.
// `$()` keeps `//` from being treated as an xcconfig comment.
TIMIA_API_BASE_URL = http:/$()/127.0.0.1:8080/core-service
TIMIA_FILE_API_BASE_URL = http:/$()/127.0.0.1:8080/file-service
TIMIA_NOTIFICATION_API_BASE_URL = http:/$()/127.0.0.1:8080/notification-service
TIMIA_GOOGLE_CLIENT_ID =
TIMIA_GOOGLE_REDIRECT_URI = https:/$()/timia.online/core-service/auth/mobile/oauth/google/callback
TIMIA_WECHAT_APP_ID =
TIMIA_WECHAT_REDIRECT_URI = https:/$()/timia.online/core-service/auth/mobile/oauth/wechat/callback
TIMIA_WECHAT_UNIVERSAL_LINK = https:/$()/timia.online/wechat/
// Must be the mobile app id itself, for example wx0123456789abcdef.
TIMIA_WECHAT_URL_SCHEME =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
