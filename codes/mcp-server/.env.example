TIMIA_API_BASE=http://127.0.0.1:8000
TIMIA_PAT=tm_pat_your_token_here
# TIMIA_READONLY=false
# TIMIA_TOOL_PROFILE=p0
# TIMIA_TIMEOUT_SECONDS=30
# TIMIA_DEFAULT_TIMEZONE=Asia/Shanghai

# HTTP transport (production / local remote MCP)
# TIMIA_MCP_TRANSPORT=http
# TIMIA_MCP_HOST=0.0.0.0
# TIMIA_MCP_PORT=8100
# TIMIA_MCP_PATH=/mcp
# For HTTP mode TIMIA_PAT is optional at process level — clients send
# Authorization: Bearer tm_pat_… on each request.
