# Production template — on server copy to /etc/timia/.env.prod (NOT inside git repo).
#   sudo cp .env.prod.example /etc/timia/.env.prod && sudo nano /etc/timia/.env.prod
# Domain: https://timia.online
#
# Do NOT keep secrets in /opt/timia/.env.prod — git pull may delete or conflict with tracked copies.
# Local dev only: codes/core-service/.env, codes/web/.env.local

# PostgreSQL
POSTGRES_USER=timia
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=timia

# API
DATABASE_URL=postgresql+psycopg://timia:CHANGE_ME@db:5432/timia
JWT_SECRET=CHANGE_ME
JWT_ISSUER=timia
JWT_AUDIENCE=timia-web
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=14
MOBILE_JWT_AUDIENCE=timia-ios
MOBILE_ACCESS_TOKEN_EXPIRES_MINUTES=15
MOBILE_SESSION_IDLE_DAYS=90
MOBILE_SESSION_ABSOLUTE_DAYS=365
MOBILE_CHALLENGE_EXPIRES_MINUTES=5
MOBILE_REFRESH_RETRY_GRACE_SECONDS=60
ENABLE_DEV_DB_TABLES=false
CORS_ORIGINS=https://timia.online
MINIMAX_API_KEY=CHANGE_ME
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TIMEOUT_SECONDS=30

# Web session (HttpOnly RT cookie). Must be true in prod (HTTPS only).
WEB_COOKIE_SECURE=true
WEB_SESSION_IDLE_DAYS=30
WEB_SESSION_ABSOLUTE_DAYS=90
WEB_COOKIE_SAMESITE=lax

# Web image build arg (docker compose build on server)
NEXT_PUBLIC_API_BASE_URL=https://timia.online/core-service
