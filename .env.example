# codes/core-service/.env
# 本地 Docker 默认库（见根目录 docker-compose.yml）：用户/库名均为 timia。
DATABASE_URL=postgresql+psycopg://timia:timia@localhost:5432/timia
JWT_SECRET=dev_secret_change_me
JWT_ISSUER=timia
JWT_AUDIENCE=timia-web
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=14
MOBILE_JWT_AUDIENCE=timia-ios
MOBILE_ACCESS_TOKEN_EXPIRES_MINUTES=15
MOBILE_SESSION_IDLE_DAYS=90
MOBILE_SESSION_ABSOLUTE_DAYS=365
MOBILE_CHALLENGE_EXPIRES_MINUTES=5
MOBILE_REFRESH_RETRY_GRACE_SECONDS=60
# When true, exposes GET /dev/db-tables for the code documentation UI (local dev only).
ENABLE_DEV_DB_TABLES=true
# Natural-language task parsing (server-side only; never expose to mobile/web clients).
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TIMEOUT_SECONDS=30

# codes/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
