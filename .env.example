# codes/core-service/.env
# 本地 Docker 默认库（见根目录 docker-compose.yml）：用户/库名均为 timia。
DATABASE_URL=postgresql+psycopg://timia:timia@localhost:5432/timia
JWT_SECRET=dev_secret_change_me
JWT_ISSUER=timia
JWT_AUDIENCE=timia-web
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=14
MOBILE_JWT_AUDIENCE=timia-ios
MOBILE_ACCESS_TOKEN_EXPIRES_MINUTES=15
MOBILE_SESSION_IDLE_DAYS=90
MOBILE_SESSION_ABSOLUTE_DAYS=365
MOBILE_CHALLENGE_EXPIRES_MINUTES=5
MOBILE_REFRESH_RETRY_GRACE_SECONDS=60
# When true, exposes GET /dev/db-tables for the code documentation UI (local dev only).
ENABLE_DEV_DB_TABLES=true
# Model keys are not stored here. System admins manage them at /settings/llm-keys.

# codes/file-service (make file-service also sources codes/core-service/.env)
FILE_INTERNAL_TOKEN=dev_file_internal_change_me
FILE_SERVICE_BASE=http://127.0.0.1:8003
NOTIFICATION_INTERNAL_TOKEN=dev_notification_internal_change_me
NOTIFICATION_SERVICE_BASE=http://127.0.0.1:8001
USER_INTERNAL_TOKEN=dev_user_internal_change_me
USER_SERVICE_BASE=http://127.0.0.1:8004
CORE_SERVICE_BASE=http://127.0.0.1:8000
# Scan due delay/scheduled notifications inside notification-service. 0 disables the loop.
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
# APNs Auth Key (.p8). Leave APNS_KEY_P8 empty to keep inbox-only delivery.
# APNS_KEY_P8 may be the PEM with \n escapes, or base64 of the PEM.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=online.timia.ios
APNS_KEY_P8=
# true: api.sandbox.push.apple.com (Xcode development). false: TestFlight / App Store.
APNS_USE_SANDBOX=true
MEDIA_BACKEND=s3
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_BUCKET=timia-files
MEDIA_S3_ACCESS_KEY=timia
MEDIA_S3_SECRET_KEY=timia_minio_dev
MEDIA_S3_REGION=us-east-1
MEDIA_S3_USE_SSL=false

# iOS phone / WeChat / Google. Leave SMS_PROVIDER empty in local dev: the code is logged
# and returned as dev_code. Do not copy that behavior to production.
# SMS_PROVIDER=
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# GOOGLE_CLIENT_IDS=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# Website app (QR) and mobile app (OpenSDK). Empty client id falls back to WECHAT_APP_*.
# WECHAT_WEB_APP_ID=
# WECHAT_WEB_APP_SECRET=
# WECHAT_MOBILE_APP_ID=
# WECHAT_MOBILE_APP_SECRET=
# WECHAT_WEB_REDIRECT_URI=http://localhost:3000/auth/wechat/web/callback
# OAUTH_DEV_MODE=false

# codes/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FILE_API_BASE_URL=http://localhost:8003
NEXT_PUBLIC_NOTIFICATION_API_BASE_URL=http://localhost:8001
