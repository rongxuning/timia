# Local all-in-Docker stack (docker-compose.local.yml). Safe to commit.
# Entry: http://localhost:8080

POSTGRES_USER=timia
POSTGRES_PASSWORD=timia
POSTGRES_DB=timia

DATABASE_URL=postgresql+psycopg://timia:timia@db:5432/timia
JWT_SECRET=dev_secret_change_me
JWT_ISSUER=timia
JWT_AUDIENCE=timia-web
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=14
MOBILE_JWT_AUDIENCE=timia-ios
MOBILE_ACCESS_TOKEN_EXPIRES_MINUTES=15
MOBILE_SESSION_IDLE_DAYS=90
MOBILE_SESSION_ABSOLUTE_DAYS=365
MOBILE_CHALLENGE_EXPIRES_MINUTES=5
MOBILE_REFRESH_RETRY_GRACE_SECONDS=60
ENABLE_DEV_DB_TABLES=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Model API keys are managed by system admins at /settings/llm-keys, not in this file.

WEB_COOKIE_SECURE=false
WEB_SESSION_IDLE_DAYS=30
WEB_SESSION_ABSOLUTE_DAYS=90
WEB_COOKIE_SAMESITE=lax

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/core-service
NEXT_PUBLIC_FILE_API_BASE_URL=http://localhost:8080/file-service
NEXT_PUBLIC_NOTIFICATION_API_BASE_URL=http://localhost:8080/notification-service

FILE_INTERNAL_TOKEN=dev_file_internal_change_me
FILE_SERVICE_BASE=http://file-service:8003
NOTIFICATION_INTERNAL_TOKEN=dev_notification_internal_change_me
NOTIFICATION_SERVICE_BASE=http://notification-service:8001
USER_INTERNAL_TOKEN=dev_user_internal_change_me
USER_SERVICE_BASE=http://user-service:8004
CORE_SERVICE_BASE=http://core-service:8000
WECHAT_WEB_REDIRECT_URI=http://localhost:8080/auth/wechat/web/callback
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=online.timia.ios
APNS_KEY_P8=
APNS_USE_SANDBOX=true
MINIO_ROOT_USER=timia
MINIO_ROOT_PASSWORD=timia_minio_dev
MEDIA_BACKEND=s3
MEDIA_S3_ENDPOINT=http://minio:9000
MEDIA_S3_BUCKET=timia-files
MEDIA_S3_ACCESS_KEY=timia
MEDIA_S3_SECRET_KEY=timia_minio_dev
MEDIA_S3_REGION=us-east-1
MEDIA_S3_USE_SSL=false
